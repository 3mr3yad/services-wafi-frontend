{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Must match the Worker name in the Cloudflare dashboard (Workers Builds checks it).
  "name": "wafi-services-frontend",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": { "enabled": true },
  // Public, non-secret runtime config. Secrets (e.g. FRONTEND_API_KEY) are set with
  // `wrangler secret put <NAME>` or in the dashboard, never here.
  "vars": {
    "API_BASE_URL": "https://wafii.sa/wafiservices/api/v1/public",
    "API_TIMEOUT_MS": "15000",
    "API_MOCKS": "false",
    // Ovfle on its own subdomain (src/lib/site/ovfle-host.ts). Attach the domain to this Worker first
    // (Settings → Domains & Routes → Custom domain), test it, then set OVFLE_PRIMARY to "true".
    "OVFLE_HOST": "ovfle.wafi.sa",
    "OVFLE_PRIMARY": "false"
  }
}
