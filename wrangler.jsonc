{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "wafi-services-frontend",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": { "enabled": true },
  "vars": {
    "API_TIMEOUT_MS": "15000",
    "API_MOCKS": "false"
  },
  // Secrets are set with `wrangler secret put <NAME> --env <env>`; never put them here.
  "env": {
    "staging": {
      "name": "wafi-services-frontend-staging",
      "vars": { "API_TIMEOUT_MS": "15000", "API_MOCKS": "false" }
    },
    "production": {
      "name": "wafi-services-frontend-production",
      "vars": { "API_TIMEOUT_MS": "15000", "API_MOCKS": "false" }
    }
  }
}
