# Copy to .env.local for local development. Never commit real values.

# Public site URL (used for metadata, canonical URLs, hreflang)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Backend API base URL. Server-only: the browser never calls the backend directly.
# Production public API (Laravel wafi-service, docs: "Public Services API"). Every path in the code is relative to it.
API_BASE_URL=https://wafii.sa/wafiservices/api/v1/public

# Default request timeout to the backend, in milliseconds
API_TIMEOUT_MS=15000

# Use labelled mock data instead of the real backend (development only)
API_MOCKS=false
